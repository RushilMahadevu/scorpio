# Scorpio Environment Configuration Template
# Duplicate this file to .env.local for development or configure these variables in your hosting provider

# --- Gemini AI Configuration ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Firebase Client SDK (Public) ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_CLIENT_ID="your-firebase-client-id"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# --- Firebase Admin SDK (Server-Side Only) ---
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Authentication & Access Control ---
ADMIN_SECRET="your-admin-secret-for-elevated-operations"

# --- Polar Metered AI & Subscription Billing ---
POLAR_ACCESS_TOKEN="polar_at_..."
POLAR_WEBHOOK_SECRET="polar_whsec_..."
POLAR_MONTHLY_ID="prod_..."
POLAR_YEARLY_ID="prod_..."

# --- Email & External Services ---
RESEND_API_KEY="re_..."
GITHUB_TOKEN=""
NEXT_PUBLIC_APP_URL="https://scorpioedu.org"

# Public demo/research calls use this network budget; never use a student network.
LANDING_ORG_ID=""
POLAR_ENV="sandbox"
