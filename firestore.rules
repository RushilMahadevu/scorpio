rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user(id) { return get(/databases/$(database)/documents/users/$(id)).data; }
    function me() { return user(request.auth.uid); }
    function teacher() { return signedIn() && me().role == 'teacher'; }
    function member(org) { return signedIn() && org != null && me().organizationId == org; }
    function teaches(teacherId) {
      return teacher() && (teacherId == request.auth.uid ||
        (teacherId != null && member(user(teacherId).organizationId)));
    }
    function ownsCourse(id) { return teacher() && id != null && get(/databases/$(database)/documents/courses/$(id)).data.teacherId == request.auth.uid; }
    function assignment(id) { return get(/databases/$(database)/documents/assignments/$(id)).data; }
    function ownsAssignment(id) { return teacher() && assignment(id).teacherId == request.auth.uid; }
    function enrolled(a) {
      return signedIn() && (a.visibility == 'global' ||
        (a.visibility == 'network' && member(a.organizationId)) ||
        (a.get('courseId', null) != null && me().get('courseId', null) == a.courseId) ||
        (a.get('courseId', null) == null && me().get('teacherId', null) == a.teacherId));
    }
    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid ||
        (teacher() && (member(resource.data.get('organizationId', null)) || teaches(resource.data.get('teacherId', null)) || ownsCourse(resource.data.get('courseId', null)))) ||
        me().get('teacherId', null) == id);
      // Authentication profiles and enrollment are provisioned only by server APIs.
      // Roster placeholders cannot grant teacher access or impersonate an Auth user.
      allow create: if teacher() && request.resource.data.keys().hasOnly(['email','displayName','teacherId','role','createdAt','status','importedBy']) &&
        request.resource.data.role == 'student' && request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.importedBy == request.auth.uid && request.resource.data.status == 'pending_invite';
      allow update: if signedIn() && (
        (id == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','email','lastLoginAt','preferences','appearance','photoURL','theme'])) ||
        (teacher() && resource.data.get('teacherId', null) == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId','courseId','organizationId']) &&
          request.resource.data.teacherId == null && request.resource.data.courseId == null && request.resource.data.organizationId == null));
    }
    match /students/{id} {
      allow read: if signedIn() && (id == request.auth.uid || teaches(resource.data.get('teacherId', null)));
    }
    match /teachers/{id} {
      allow read: if signedIn() && (id == request.auth.uid || teaches(id) || me().get('teacherId', null) == id);
    }
    match /assignments/{id} {
      // Legacy documents must be migrated before they can be read by students.
      allow read: if signedIn() && ((teacher() && (resource.data.teacherId == request.auth.uid || resource.data.visibility == 'global' || member(resource.data.get('organizationId', null)))) ||
        (resource.data.get('answerKeySeparated', false) == true && enrolled(resource.data)));
      allow delete: if teacher() && resource.data.teacherId == request.auth.uid;
    }
    match /assignment_keys/{id} {
      allow read: if ownsAssignment(id);
    }
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || ownsAssignment(resource.data.assignmentId));
      // Student submissions are validated and normalized by the authenticated API.
      allow update: if ownsAssignment(resource.data.assignmentId) &&
        request.resource.data.assignmentId == resource.data.assignmentId && request.resource.data.studentId == resource.data.studentId;
      allow delete: if ownsAssignment(resource.data.assignmentId);
    }
    match /courses/{id} {
      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid || me().get('courseId', null) == id || (teacher() && teaches(resource.data.teacherId)));

      allow update: if ownsCourse(id) && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.get('organizationId', null) == resource.data.get('organizationId', null);
      allow delete: if ownsCourse(id);
    }
    match /resources/{id} {
      allow read: if signedIn() && (teaches(resource.data.teacherId) || me().get('teacherId', null) == resource.data.teacherId);
      allow create: if teacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if teacher() && resource.data.teacherId == request.auth.uid;
    }
    match /practice_history/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || teaches(user(resource.data.studentId).get('teacherId', null)));
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId;
      allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }
    match /notebooks/{id} {
      allow read, delete: if signedIn() && (resource.data.studentId == request.auth.uid || id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId;
    }
    match /tutor_sessions/{id} {
      allow read, delete: if signedIn() && (resource.data.studentId == request.auth.uid || id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId;
    }
    match /organizations/{id} {
      allow read: if member(id);
      allow update: if teacher() && resource.data.ownerId == request.auth.uid && (
        (resource.data.get('planId', 'free') != 'free' || request.resource.data.get('aiBudgetLimit', 0) <= resource.data.get('aiBudgetLimit', 0)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','aiBudgetLimit','practiceLimitPerStudent','practiceLimit','notebookLimitPerStudent','aiNotebookLimitPerStudent','aiTutorLimitPerStudent','notebookLimit']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId']) && user(request.resource.data.ownerId).role == 'teacher' && user(request.resource.data.ownerId).organizationId == id));
    }
    match /portfolios/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || teaches(user(resource.data.studentId).get('teacherId', null)));
    }
    match /usage_analytics/{id} {
      allow read: if teacher() && member(resource.data.organizationId);
    }
    // Every other collection, including invitations and billing state, is server-only.
  }
}
